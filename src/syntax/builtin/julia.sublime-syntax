%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: Julia
scope: source.julia
file_extensions: [jl]
first_line_match: '^#!.*\bjulia\b'
contexts:
  main:
    - include: comments
    - include: strings
    - include: macros
    - include: decls
    - include: keywords
    - include: numbers
    - include: symbols
    - include: functions
    - include: types
    - include: operators

  comments:
    - match: '#='
      scope: punctuation.definition.comment.begin.julia
      push: block-comment
    - match: '#.*$'
      scope: comment.line.number-sign.julia

  block-comment:
    - meta_scope: comment.block.julia
    - match: '#='
      push: block-comment
    - match: '=#'
      scope: punctuation.definition.comment.end.julia
      pop: true

  strings:
    - match: '(?:[a-zA-Z_]\w*)?"""'
      scope: punctuation.definition.string.begin.julia
      push: triple
    - match: '[a-zA-Z_]\w*"'
      scope: punctuation.definition.string.begin.julia
      push: raw-dq
    - match: '"'
      scope: punctuation.definition.string.begin.julia
      push: dq
    - match: '`'
      scope: punctuation.definition.string.begin.julia
      push: cmd
    - match: "(?<![\\w\\]\\)}'.])'(?:\\\\(?:.|u[0-9A-Fa-f]{1,4}|x[0-9A-Fa-f]{1,2})|[^'\\\\])'"
      scope: string.quoted.single.julia

  triple:
    - meta_scope: string.quoted.triple.julia
    - match: '"""'
      scope: punctuation.definition.string.end.julia
      pop: true
    - include: escapes
    - include: interp

  raw-dq:
    - meta_scope: string.quoted.double.julia
    - match: '\\"'
    - match: '"'
      scope: punctuation.definition.string.end.julia
      pop: true
    - match: '$'
      pop: true

  dq:
    - meta_scope: string.quoted.double.julia
    - match: '"'
      scope: punctuation.definition.string.end.julia
      pop: true
    - match: '$'
      pop: true
    - include: escapes
    - include: interp

  cmd:
    - meta_scope: string.quoted.other.julia
    - match: '`'
      scope: punctuation.definition.string.end.julia
      pop: true
    - match: '$'
      pop: true
    - include: interp

  escapes:
    - match: '\\(?:[abfnrtv0"''\\$]|x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{1,4}|U[0-9A-Fa-f]{1,8}|[0-7]{1,3})'
      scope: constant.character.escape.julia

  interp:
    - match: '\$\([^)]*\)|\$[A-Za-z_]\w*'
      scope: variable.parameter.interpolation.julia

  macros:
    - match: '@[A-Za-z_][\w.!]*'
      scope: meta.annotation.julia

  decls:
    - match: '\b(function|macro)\s+(?:[A-Za-z_][\w.]*\.)?([A-Za-z_][\w!]*)'
      captures:
        1: storage.type.function.julia
        2: entity.name.function.julia
    - match: '\b(struct|abstract\s+type|primitive\s+type|module|baremodule)\s+([A-Za-z_]\w*)'
      captures:
        1: storage.type.julia
        2: entity.name.type.julia
    - match: '^\s*([A-Za-z_][\w!]*)\s*\([^)]*\)\s*='
      captures:
        1: entity.name.function.julia

  keywords:
    - match: '\b(?:true|false)\b'
      scope: constant.language.boolean.julia
    - match: '\b(?:nothing|missing|NaN|Inf|NaN32|Inf32|pi|π|ℯ|undef)\b'
      scope: constant.language.julia
    - match: '\b(?:Int|Int8|Int16|Int32|Int64|Int128|UInt|UInt8|UInt16|UInt32|UInt64|UInt128|Float16|Float32|Float64|Bool|Char|String|Symbol|Any|Nothing|Number|Real|Integer|AbstractString|AbstractArray|Vector|Matrix|Array|Dict|Set|Tuple|NamedTuple|Union|Complex|Rational|Function|Type|Missing)\b'
      scope: storage.type.primitive.julia
    - match: '\b(?:mutable|const|global|local|where|primitive|abstract|outer)\b'
      scope: storage.modifier.julia
    - match: '\b(?:if|elseif|else|for|while|begin|end|do|let|try|catch|finally|return|break|continue|quote|import|using|export|public|in)\b'
      scope: keyword.control.julia
    - match: '\b(?:isa|in)\b'
      scope: keyword.operator.word.julia

  numbers:
    - match: '\b0[xX][0-9A-Fa-f_]+\b'
      scope: constant.numeric.hex.julia
    - match: '\b0[bB][01_]+\b|\b0[oO][0-7_]+\b'
      scope: constant.numeric.binary.julia
    - match: '(?<![A-Za-z0-9_.])(?:[0-9][0-9_]*\.[0-9_]*|\.[0-9][0-9_]*|[0-9][0-9_]*)(?:[eEf][-+]?[0-9_]+)?(?:im)?(?![A-Za-z0-9_])'
      scope: constant.numeric.decimal.julia

  symbols:
    - match: '(?<![:\w\]\)}])::?[A-Za-z_]\w*'
      scope: variable.parameter.symbol.julia

  functions:
    - match: '\b(?:println|print|show|display|push!|pop!|append!|length|size|map|filter|reduce|foldl|foldr|sum|prod|collect|zip|enumerate|range|string|parse|sort|sort!|keys|values|haskey|get|get!|error|throw|typeof|isnothing|ismissing|zeros|ones|rand|sqrt|abs|min|max|print|printf|join|split|replace|open|close|readline|readlines|eachline|first|last|reverse|any|all|isempty|convert|promote|similar|copy|deepcopy|eval|include|require)(?=\s*\()'
      scope: support.function.julia
    - match: '\b[a-z_][\w!]*(?=\()'
      scope: entity.name.function.julia

  types:
    - match: '::\s*[A-Za-z_][\w.{},\s]*'
      scope: entity.name.type.julia
    - match: '\b[A-Z]\w*\b'
      scope: entity.name.type.julia

  operators:
    - match: '\.\.\.?|=>|->|\|>|<:|>:|::|[-+*/\\%&|^<>=!~?:÷×≤≥≠≈∈∉∪∩⊆]+'
      scope: keyword.operator.julia
