      push: [hd-stop-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])_EOF_\2|\\_EOF_)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-eof_-raw, rest-of-line]
    - match: '(<<-?)\s*_EOF_(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-eof_-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])ENDOFFILE\2|\\ENDOFFILE)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-endoffile-raw, rest-of-line]
    - match: '(<<-?)\s*ENDOFFILE(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-endoffile-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])EOC\2|\\EOC)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-eoc-raw, rest-of-line]
    - match: '(<<-?)\s*EOC(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-eoc-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])CONFIG\2|\\CONFIG)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-config-raw, rest-of-line]
    - match: '(<<-?)\s*CONFIG(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-config-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])EOD\2|\\EOD)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-eod-raw, rest-of-line]
    - match: '(<<-?)\s*EOD(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-eod-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])DATA\2|\\DATA)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-data-raw, rest-of-line]
    - match: '(<<-?)\s*DATA(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-data-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])INPUT\2|\\INPUT)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-input-raw, rest-of-line]
    - match: '(<<-?)\s*INPUT(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-input-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])[A-Za-z_][A-Za-z0-9_.-]*\2|\\[A-Za-z_][A-Za-z0-9_.-]*)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-generic-raw, rest-of-line]
    - match: '(<<-?)\s*[A-Za-z_][A-Za-z0-9_.-]*(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
      push: [hd-generic-exp, rest-of-line]

  rest-of-line:
    - match: '(?=$)'
      pop: true
    - include: line-rules

  hd-eof-raw:
    - meta_scope: string.unquoted.heredoc.shell
    - match: '^\t*EOF\s*$'
      scope: constant.other.heredoc-delimiter.shell
      pop: true
  hd-eof-exp:
    - meta_scope: string.unquoted.heredoc.shell
    - match: '^\t*EOF\s*$'
      scope: constant.other.heredoc-delimiter.shell
      pop: true
    - include: heredoc-expansions
  hd-eot-raw:
    - meta_scope: string.unquoted.heredoc.shell
    - match: '^\t*EOT\s*$'
      scope: constant.other.heredoc-delimiter.shell
      pop: true
  hd-eot-exp:
