      push: [hd-msg-exp, rest-of-line]
    - match: '(<<-?)\s*(?:(["''])STOP\2|\\STOP)(?![\w.-])'
      captures:
        1: keyword.operator.redirection.shell
        2: punctuation.definition.string.begin.shell
      push: [hd-stop-raw, rest-of-line]
    - match: '(<<-?)\s*STOP(?![\w.-])'
      captures:
