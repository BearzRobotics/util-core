%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: JavaScript
scope: source.ts
file_extensions:
  - ts
  - tsx
  - mts
  - cts
first_line_match: '^#!.*\b(?:ts-node|tsx|deno|bun)\b|-\*-\s*(?:ts|typescript)\s*-\*-'

variables:
  ident: '[A-Za-z_$][A-Za-z0-9_$]*'

contexts:
  main:
    - match: '^#!.*$'
      scope: comment.line.shebang.ts
    - include: code

  code:
    - include: comments
    - include: strings
    - include: regex
    - include: jsx
    - include: numbers
    - include: decorators
    - include: keywords
    - include: builtins
    - include: types
    - include: functions
    - include: operators
    - match: '\{'
      push: braces

  braces:
    - match: '\}'
      pop: true
    - include: code

  comments:
    - match: '/\*\*(?!/)'
      scope: punctuation.definition.comment.begin.ts
      push: doc-block-comment
    - match: '/\*'
      scope: punctuation.definition.comment.begin.ts
      push: block-comment
    - match: '//.*$'
      scope: comment.line.double-slash.ts
    - match: '<!--.*$'
      scope: comment.line.html.ts

  block-comment:
    - meta_scope: comment.block.ts
    - match: '\*/'
      scope: punctuation.definition.comment.end.ts
      pop: true

  doc-block-comment:
    - meta_scope: comment.block.documentation.ts
    - match: '\*/'
      scope: punctuation.definition.comment.end.ts
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.ts
      push: dq-string
    - match: '\x27'
      scope: punctuation.definition.string.begin.ts
      push: sq-string
    - match: '`'
      scope: string.template.ts punctuation.definition.string.begin.ts
      push: template

  dq-string:
    - meta_scope: string.quoted.double.ts
    - match: '"'
      scope: punctuation.definition.string.end.ts
      pop: true
    - include: string-escapes
    - match: '\n'
      pop: true

  sq-string:
    - meta_scope: string.quoted.single.ts
    - match: '\x27'
      scope: punctuation.definition.string.end.ts
      pop: true
    - include: string-escapes
    - match: '\n'
      pop: true

  string-escapes:
    - match: '\\(?:x\h{2}|u\h{4}|u\{\h+\}|[0-7]{1,3}|.)'
      scope: constant.character.escape.ts
    - match: '\\\n'
      scope: constant.character.escape.ts

  template:
    - match: '`'
      scope: string.template.ts punctuation.definition.string.end.ts
      pop: true
    - match: '\\(?:x\h{2}|u\h{4}|u\{\h+\}|[0-7]{1,3}|.)|\\\n'
      scope: string.template.ts constant.character.escape.ts
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.ts
      push: template-interp
    - match: '[^`\\$]+|\$'
      scope: string.template.ts

  template-interp:
    - match: '\}'
      scope: punctuation.section.interpolation.end.ts
      pop: true
    - include: code

  regex:
    - match: '^(\s*)(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        2: punctuation.definition.string.begin.ts
      push: regex-body
    - match: '([=(,:;!&|?\[+\-*%<>~^]+)(\s*)(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        1: keyword.operator.ts
        3: punctuation.definition.string.begin.ts
      push: regex-body
    - match: '\b(return|typeof|case|in|of|delete|void|throw|yield|await|else|do)(\s+|\s*(?=/))(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        1: keyword.control.ts
        3: punctuation.definition.string.begin.ts
      push: regex-body

  regex-body:
    - meta_scope: string.regexp.ts
    - match: '(/)([dgimsuvy]*)'
      captures:
        1: punctuation.definition.string.end.ts
        2: keyword.other.ts
      pop: true
    - match: '\\.'
      scope: constant.character.escape.ts
    - match: '\[(?:[^\]\\\n]|\\.)*\]'
      scope: constant.other.character-class.set.ts
    - match: '[()|*+?]|\{\d+(?:,\d*)?\}'
      scope: keyword.operator.regexp.ts
    - match: '\n'
      pop: true

  jsx:
    - match: '^(\s*)(<)(/?)([a-z][\w.:-]*|[A-Z][\w.:-]+)(?=[\s/>])'
      captures:
        2: punctuation.definition.tag.begin.ts
        3: punctuation.definition.tag.begin.ts
        4: entity.name.tag.ts
      push: jsx-tag
    - match: '(?:[=(,:?&|\[]|=>|\breturn)(\s*)(<)(/?)([a-z][\w.:-]*|[A-Z][\w.:-]+)(?=[\s/>])'
      captures:
        2: punctuation.definition.tag.begin.ts
        3: punctuation.definition.tag.begin.ts
        4: entity.name.tag.ts
      push: jsx-tag
    - match: '(</)([a-z][\w.:-]*|[A-Z][\w.:-]+)(>)'
      captures:
        1: punctuation.definition.tag.begin.ts
        2: entity.name.tag.ts
        3: punctuation.definition.tag.end.ts

  jsx-tag:
    - match: '/?>'
      scope: punctuation.definition.tag.end.ts
      pop: true
    - match: '[A-Za-z_][\w:.-]*'
      scope: entity.other.attribute-name.ts
    - match: '"[^"]*"'
      scope: string.quoted.double.ts
    - match: '\x27[^\x27]*\x27'
      scope: string.quoted.single.ts
    - match: '\{'
      push: braces
    - include: comments
    - match: '='
      scope: keyword.operator.assignment.ts

  numbers:
    - match: '(?<![\w$.])0[xX][\h_]+n?(?![\w$])'
      scope: constant.numeric.hex.ts
    - match: '(?<![\w$.])0[oO][0-7_]+n?(?![\w$])'
      scope: constant.numeric.octal.ts
    - match: '(?<![\w$.])0[bB][01_]+n?(?![\w$])'
      scope: constant.numeric.binary.ts
    - match: '(?<![\w$.])(?:\d[\d_]*\.[\d_]*|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?![\w$])'
      scope: constant.numeric.float.ts
    - match: '(?<![\w$.])\d[\d_]*[eE][+-]?\d[\d_]*(?![\w$])'
      scope: constant.numeric.float.ts
    - match: '(?<![\w$.])\d[\d_]*n?(?![\w$])'
      scope: constant.numeric.integer.ts

  decorators:
    - match: '@{{ident}}(?:\.{{ident}})*'
      scope: meta.annotation.ts

  keywords:
    - match: '\b(interface)\b\s+({{ident}})'
      captures:
        1: storage.type.interface.ts
        2: entity.name.type.interface.ts
    - match: '\b(type)\b\s+({{ident}})(?=\s*[=<])'
      captures:
        1: storage.type.type.ts
        2: entity.name.type.alias.ts
    - match: '\b(?:(const)\s+)?(enum)\b\s+({{ident}})'
      captures:
        1: storage.modifier.ts
        2: storage.type.enum.ts
        3: entity.name.type.enum.ts
    - match: '\b(namespace|module)\b\s+({{ident}}(?:\.{{ident}})*)(?=\s*\{)'
      captures:
        1: storage.type.namespace.ts
        2: entity.name.namespace.ts
    - match: '\bimplements\b'
      scope: storage.modifier.implements.ts
    - match: '\b(?:public|private|protected|readonly|abstract|declare|override|accessor)\b(?=\s+[\w\[{*#$])'
      scope: storage.modifier.ts
    - match: '\b(?:keyof|infer|satisfies|asserts)\b(?=\s+[\w\[{(\x27"])'
      scope: keyword.operator.word.ts
    - match: '\b(?:as|is)\b(?=\s+(?:const\b|[\w\[{(\x27"`]))'
      scope: keyword.operator.cast.ts
    - match: '(?<![.\w$])(?:string|number|boolean|any|unknown|never|object|symbol|bigint|void)\b'
      scope: support.type.primitive.ts
    - match: '\b(?:if|else|for|while|do|switch|case|default|break|continue|return|throw|try|catch|finally|yield|await|with|debugger)\b'
      scope: keyword.control.ts
    - match: '\b(?:import|export|from)\b(?=\s*(?:[{*"\x27]|$|\w))'
      scope: keyword.control.import.ts
    - match: '\b(?:import|export)\b'
      scope: keyword.control.import.ts
    - match: '\b(function)\b(?:(\s*\*?\s*)({{ident}}))?'
      captures:
        1: storage.type.function.ts
        3: entity.name.function.ts
    - match: '\b(class)\b(?:\s+({{ident}}))?(?:\s+(extends)\s+({{ident}}(?:\.{{ident}})*))?'
      captures:
        1: storage.type.class.ts
        2: entity.name.class.ts
        3: storage.modifier.extends.ts
        4: entity.other.inherited-class.ts
    - match: '\bextends\b'
      scope: storage.modifier.extends.ts
    - match: '\b(var|let|const)\b(?:\s+({{ident}})(?=\s*=\s*(?:async\s+)?(?:function\b|\([^()]*\)\s*=>|{{ident}}\s*=>)))?'
      captures:
        1: storage.type.ts
        2: entity.name.function.ts
    - match: '\b(?:var|let|const)\b'
      scope: storage.type.ts
    - match: '\b(?:static|async)\b(?=\s+(?:function\b|{{ident}}|\*|\[|\())'
      scope: storage.modifier.ts
    - match: '\b(?:get|set)\b(?=\s+{{ident}}\s*\()'
      scope: storage.modifier.ts
    - match: '\b(new)\b(?:\s+({{ident}}))?'
      captures:
        1: keyword.operator.new.ts
        2: entity.name.class.ts
    - match: '\b(?:delete|typeof|instanceof|in|of)\b'
      scope: keyword.operator.word.ts
    - match: '\b(?:this|super|arguments)\b'
      scope: variable.language.ts
    - match: '\b(?:true|false|null|undefined|NaN|Infinity)\b'
      scope: constant.language.ts

  builtins:
    - match: '\b(?:Array|Object|String|Number|Boolean|Symbol|BigInt|Function|Map|Set|WeakMap|WeakSet|WeakRef|Promise|Date|RegExp|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError|AggregateError|Math|JSON|Reflect|Proxy|Intl|ArrayBuffer|SharedArrayBuffer|DataView|Atomics|Int8Array|Uint8Array|Uint8ClampedArray|Int16Array|Uint16Array|Int32Array|Uint32Array|Float32Array|Float64Array|BigInt64Array|BigUint64Array|Buffer|URL|URLSearchParams|TextEncoder|TextDecoder)\b'
      scope: support.class.builtin.ts
    - match: '\b(?:console|window|document|process|module|exports|globalThis|global|navigator|localStorage|sessionStorage|__dirname|__filename)\b'
      scope: support.type.object.ts
    - match: '\b(?:require|parseInt|parseFloat|isNaN|isFinite|setTimeout|setInterval|clearTimeout|clearInterval|setImmediate|queueMicrotask|fetch|alert|encodeURIComponent|decodeURIComponent|encodeURI|decodeURI|structuredClone)(?=\s*\()'
      scope: support.function.ts

  types:
    - match: '\b[A-Z][A-Z0-9_]{2,}\b(?!\s*[(<])'
      scope: support.constant.ts
    - match: '\b[A-Z][A-Za-z0-9_$]*\b(?!\s*\()'
      scope: entity.name.type.ts

  functions:
    - match: '{{ident}}(?=\s*\()'
      scope: entity.name.function.ts
    - match: '{{ident}}(?=<[^<>()=;]*(?:<[^<>()=;]*>[^<>()=;]*)*>\s*\()'
      scope: entity.name.function.ts

  operators:
    - match: '=>'
      scope: storage.type.function.arrow.ts
    - match: '\.\.\.|\?\?=?|\?\.(?!\d)|\*\*=?|&&=?|\|\|=?|>>>=?|>>=?|<<=?|[-+*/%&|^!<>=]=?=?|~|\?|:'
      scope: keyword.operator.ts
