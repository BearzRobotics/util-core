%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: Sass
scope: source.sass
file_extensions: [sass]
contexts:
  main:
    - match: '^[ \t]*//.*$'
      scope: comment.line.double-slash.sass
    - match: '^[ \t]*/\*'
      scope: comment.block.sass
      push: block-comment
    - match: '^[ \t]*(\$[-\w]+)[ \t]*(:)'
      captures:
        1: variable.parameter.sass
        2: punctuation.separator.key-value.sass
      push: value
    - match: '^[ \t]*(=)[ \t]*([-\w]+)'
      captures:
        1: keyword.control.at-rule.sass
        2: entity.name.function.sass
      push: value
    - match: '^[ \t]*(\+)([-\w.]+)'
      captures:
        1: keyword.control.at-rule.sass
        2: entity.name.function.sass
      push: value
    - match: '^[ \t]*(@)(mixin|function)\b[ \t]*([-\w]+)?'
      captures:
        1: keyword.control.at-rule.sass
        2: keyword.control.at-rule.sass
        3: entity.name.function.sass
      push: value
    - match: '^[ \t]*(@)(include)\b[ \t]*([-\w.]+)?'
      captures:
        1: keyword.control.at-rule.sass
        2: keyword.control.at-rule.sass
        3: entity.name.function.sass
      push: value
    - match: '^[ \t]*@[-\w]+'
      scope: keyword.control.at-rule.sass
      push: value
    - match: '^[ \t]*(:)([-\w]+)'
      captures:
        1: punctuation.separator.key-value.sass
        2: support.type.property-name.sass
      push: value
    - match: '^[ \t]*(--?[A-Za-z_][-\w]*|[a-z][-\w]*)(:)(?=[ \t]|$)'
      captures:
        1: support.type.property-name.sass
        2: punctuation.separator.key-value.sass
      push: value
    - match: '^[ \t]*(?=\S)'
      push: selector-line

  # Indented comment bodies cannot be tracked without back-references:
  # an unterminated block comment ends at "*/" or at the next line that
  # starts in column 0.
  block-comment:
    - meta_scope: comment.block.sass
    - match: '^(?=\S)'
      pop: true
    - match: '\*/'
      pop: true

  selector-line:
    - match: '$'
      pop: true
    - match: '//.*$'
      scope: comment.line.double-slash.sass
    - match: '#\{[^}\n]*\}'
      scope: variable.parameter.interpolation.sass
    - match: '%[-\w]+'
      scope: entity.name.class.placeholder.sass
    - match: '\.[-\w]+'
      scope: entity.name.class.sass
    - match: '#[-\w]+'
      scope: entity.name.class.id.sass
    - match: '::?[-\w]+'
      scope: support.type.pseudo-class.sass
    - match: '&'
      scope: keyword.operator.parent-selector.sass
    - match: '\[[^\]\n]*\]'
      scope: support.type.attribute.sass
    - match: '(?<![-\w$])[A-Za-z][-\w]*'
      scope: entity.name.tag.sass
    - match: '[>+~*,]'
      scope: keyword.operator.combinator.sass

  value:
    - match: '$'
      pop: true
    - match: '//.*$'
      scope: comment.line.double-slash.sass
    - match: '"'
      scope: punctuation.definition.string.begin.sass
      push: dq-string
    - match: "'"
      scope: punctuation.definition.string.begin.sass
      push: sq-string
    - match: '#\{[^}\n]*\}'
      scope: variable.parameter.interpolation.sass
    - match: '\$[-\w]+'
      scope: variable.parameter.sass
    - match: '!(?:important|default|global|optional)\b'
      scope: keyword.other.important.sass
    - match: '#[0-9A-Fa-f]{3,8}\b'
      scope: constant.other.color.sass
    - match: '(?<![-\w])[-+]?(?:[0-9]+\.?[0-9]*|\.[0-9]+)(?:[eE][-+]?[0-9]+)?(?:%|[A-Za-z]+)?'
      scope: constant.numeric.sass
    - match: '\b(?:true|false|null|auto|none|inherit|initial|unset|transparent|currentColor)\b'
      scope: constant.language.sass
    - match: '([-\w]+)(?=\()'
      scope: support.function.sass
    - match: '(?<![-\w])[A-Za-z_][-\w]*'
    - match: '\b(?:and|or|not)\b'
      scope: keyword.operator.word.sass
    - match: '[-+*/%=<>!]=?|\.\.\.'
      scope: keyword.operator.sass

  dq-string:
    - meta_scope: string.quoted.double.sass
    - match: '"'
      scope: punctuation.definition.string.end.sass
      pop: true
    - match: '\\.'
      scope: constant.character.escape.sass
    - match: '#\{[^}\n]*\}'
      scope: variable.parameter.interpolation.sass
    - match: '$'
      pop: true

  sq-string:
    - meta_scope: string.quoted.single.sass
    - match: "'"
      scope: punctuation.definition.string.end.sass
      pop: true
    - match: '\\.'
      scope: constant.character.escape.sass
    - match: '$'
      pop: true
