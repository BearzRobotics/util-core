%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: Odin
scope: source.odin
file_extensions: [odin]
contexts:
  main:
    - include: comments
    - include: strings
    - include: attributes
    - include: directives
    - match: '\b([A-Za-z_]\w*)\s*(::)\s*(?=(?:#\w+\s+)*proc\b)'
      captures:
        1: entity.name.function.odin
        2: keyword.operator.odin
    - match: '\b([A-Za-z_]\w*)\s*(::)\s*(?=(?:#\w+(?:\([^)]*\))?\s+)*(?:struct|union|enum|bit_set|bit_field|distinct)\b)'
      captures:
        1: entity.name.type.odin
        2: keyword.operator.odin
    - match: '\b([A-Za-z_]\w*)\s*(::)'
      captures:
        1: support.constant.odin
        2: keyword.operator.odin
    - include: numbers
    - match: '\b(?:package|import|foreign|proc|struct|union|enum|bit_set|bit_field|map|defer|if|else|when|for|in|not_in|switch|case|return|using|do|break|continue|fallthrough|context|cast|transmute|auto_cast|distinct|dynamic|where|or_else|or_return|or_break|or_continue|matrix|asm)\b'
      scope: keyword.control.odin
    - match: '\b(?:true|false|nil|ODIN_\w+)\b'
      scope: constant.language.odin
    - match: '\b(?:int|uint|uintptr|rune|string|cstring|bool|b8|b16|b32|b64|rawptr|typeid|any|byte|i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f16|f32|f64|i16le|i32le|i64le|i128le|u16le|u32le|u64le|u128le|i16be|i32be|i64be|i128be|u16be|u32be|u64be|u128be|f16le|f32le|f64le|f16be|f32be|f64be|complex32|complex64|complex128|quaternion64|quaternion128|quaternion256)\b'
      scope: storage.type.odin
    - match: '\b(?:len|cap|size_of|align_of|offset_of|type_of|type_info_of|typeid_of|make|new|delete|free|append|append_elem|clear|reserve|resize|copy|min|max|abs|clamp|swizzle|raw_data|assert|panic|unimplemented|unreachable|ensure|incl|excl|pop|inject_at|ordered_remove|unordered_remove|card|soa_zip|soa_unzip|transpose|determinant)(?=\s*\()'
      scope: support.function.builtin.odin
    - match: '\b([A-Za-z_]\w*)(?=\s*\()'
      scope: support.function.call.odin
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: support.type.odin
    - match: ':=|:=|->|\.\.<|\.\.=|\.\.|<<=|>>=|&&=|\|\|=|&~=|[-+*/%&|~^<>=!]=|<<|>>|&~|&&|\|\||---|[-+*/%&|~^<>=!?\\@$:]'
      scope: keyword.operator.odin
    - match: '[{}()\[\];,.]'
      scope: punctuation.odin

  comments:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.odin
      push: block-comment
    - match: '//.*$'
      scope: comment.line.double-slash.odin
    - match: '\A#!.*$'
      scope: comment.line.shebang.odin

  block-comment:
    - meta_scope: comment.block.odin
    - match: '/\*'
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.odin
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.odin
      push: dq-string
    - match: '`'
      scope: punctuation.definition.string.begin.odin
      push: raw-string
    - match: "'"
      scope: punctuation.definition.string.begin.odin
      push: rune

  dq-string:
    - meta_scope: string.quoted.double.odin
    - include: escapes
    - match: '"'
      scope: punctuation.definition.string.end.odin
      pop: true
    - match: '$'
      pop: true

  raw-string:
    - meta_scope: string.quoted.other.raw.odin
    - match: '`'
      scope: punctuation.definition.string.end.odin
      pop: true

  rune:
    - meta_scope: string.quoted.single.odin
    - include: escapes
    - match: "'"
      scope: punctuation.definition.string.end.odin
      pop: true
    - match: '$'
      pop: true

  escapes:
    - match: '\\(?:[abefnrtv\\''"0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{3})'
      scope: constant.character.escape.odin
    - match: '\\.'
      scope: invalid.illegal.escape.odin

  attributes:
    - match: '@\s*\('
      scope: meta.annotation.odin
      push: attribute-args
    - match: '@[A-Za-z_]\w*'
      scope: meta.annotation.odin

  attribute-args:
    - meta_scope: meta.annotation.odin
    - match: '\)'
      pop: true
    - match: '\('
      push: attribute-args
    - include: strings
    - include: numbers
    - match: '[A-Za-z_]\w*'
      scope: meta.annotation.odin

  directives:
    - match: '#[A-Za-z_]\w*'
      scope: meta.annotation.directive.odin

  numbers:
    - match: '\b0[xX][0-9A-Fa-f_]+(?:\.[0-9A-Fa-f_]+)?(?:[pP][-+]?[0-9_]+)?[ijk]?\b'
      scope: constant.numeric.hex.odin
    - match: '\b0b[01_]+[ijk]?\b'
      scope: constant.numeric.binary.odin
    - match: '\b0o[0-7_]+[ijk]?\b'
      scope: constant.numeric.octal.odin
    - match: '\b0[dz][0-9a-zA-Z_]+\b'
      scope: constant.numeric.integer.odin
    - match: '\b[0-9][0-9_]*\.[0-9][0-9_]*(?:[eE][-+]?[0-9_]+)?[ijk]?\b'
      scope: constant.numeric.float.odin
    - match: '\b[0-9][0-9_]*[eE][-+]?[0-9_]+[ijk]?\b'
      scope: constant.numeric.float.odin
    - match: '\b[0-9][0-9_]*[ijk]?\b'
      scope: constant.numeric.integer.odin
