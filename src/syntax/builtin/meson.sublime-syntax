%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: Meson
scope: source.meson
file_extensions: [meson, meson.build, meson_options.txt, meson.options]
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.meson
    - match: "'''"
      scope: punctuation.definition.string.begin.meson
      push: mlstring
    - match: "'"
      scope: punctuation.definition.string.begin.meson
      push: sq
    - match: '\b(?:if|elif|else|endif|foreach|endforeach|break|continue)\b'
      scope: keyword.control.meson
    - match: '\b(?:and|or|not|in)\b'
      scope: keyword.operator.word.meson
    - match: '\b(?:true|false)\b'
      scope: constant.language.boolean.meson
    - match: '\b(?:meson|host_machine|build_machine|target_machine)\b'
      scope: variable.language.meson
    - match: '\b(?:project|executable|library|shared_library|static_library|both_libraries|shared_module|jar|custom_target|run_target|alias_target|dependency|declare_dependency|find_program|include_directories|subdir|subproject|files|configure_file|install_data|install_headers|install_man|install_subdir|install_emptydir|install_symlink|test|benchmark|generator|add_global_arguments|add_global_link_arguments|add_project_arguments|add_project_link_arguments|add_languages|add_test_setup|assert|error|warning|message|summary|option|get_option|import|is_variable|get_variable|set_variable|is_disabler|disabler|environment|configuration_data|run_command|vcs_tag|build_target|range|structured_sources|unset_variable|subdir_done|join_paths|gettext|debug)\b(?=\s*\()'
      scope: support.function.builtin.meson
    - match: '\.\s*([A-Za-z_]\w*)(?=\s*\()'
      captures:
        1: support.function.method.meson
    - match: '\b[A-Za-z_]\w*(?=\s*\()'
      scope: entity.name.function.meson
    - match: '\b(?:0[xX][0-9A-Fa-f]+|0[oO][0-7]+|0[bB][01]+|[0-9]+)\b'
      scope: constant.numeric.meson
    - match: '[-+*/%]=?|==|!=|<=|>=|<|>|=|\?'
      scope: keyword.operator.meson
  sq:
    - meta_scope: string.quoted.single.meson
    - match: "'"
      scope: punctuation.definition.string.end.meson
      pop: true
    - match: '\\(?:[abfnrtv\\''0]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|N\{[^}]*\}|[0-7]{1,3})'
      scope: constant.character.escape.meson
    - match: '@[A-Za-z_]\w*@'
      scope: variable.parameter.meson
    - match: '$'
      pop: true
  mlstring:
    - meta_scope: string.quoted.triple.meson
    - match: "'''"
      scope: punctuation.definition.string.end.meson
      pop: true
    - match: '@[A-Za-z_]\w*@'
      scope: variable.parameter.meson
