%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: CMake
scope: source.cmake
file_extensions: [cmake, CMakeLists.txt, CMakeCache.txt, ctest, cpack]
contexts:
  main:
    - match: '#\[(=*)\['
      scope: punctuation.definition.comment.begin.cmake
      push: bracket-comment
    - match: '#.*$'
      scope: comment.line.number-sign.cmake
    - match: '\[(=*)\['
      scope: punctuation.definition.string.begin.cmake
      push: bracket-arg
    - match: '"'
      scope: punctuation.definition.string.begin.cmake
      push: dq
    - include: vars
    - match: '(?i)\b(if|elseif|else|endif|foreach|endforeach|while|endwhile|function|endfunction|macro|endmacro|block|endblock|return|break|continue)\b(?=\s*\()'
      scope: keyword.control.cmake
    - match: '(?i)\b(?:AND|OR|NOT|STREQUAL|EQUAL|LESS|GREATER|MATCHES|DEFINED|EXISTS|IN_LIST|VERSION_LESS|VERSION_GREATER|VERSION_EQUAL|COMMAND|TARGET|IS_DIRECTORY)\b'
      scope: keyword.operator.word.cmake
    - match: '\b(?:PUBLIC|PRIVATE|INTERFACE|STATIC|SHARED|MODULE|OBJECT|REQUIRED|COMPONENTS|QUIET|CACHE|FORCE|PARENT_SCOPE|BOOL|STRING|PATH|FILEPATH|INTERNAL|DESTINATION|TARGETS|FILES|PROPERTIES|ON|OFF|TRUE|FALSE|YES|NO|VERSION|LANGUAGES|DESCRIPTION)\b'
      scope: constant.language.cmake
    - match: '\b[A-Za-z_]\w*(?=\s*\()'
      scope: entity.name.function.cmake
    - match: '\b[0-9]+(?:\.[0-9]+)*\b'
      scope: constant.numeric.cmake

  vars:
    - match: '\$\{[^}\n]*\}|\$ENV\{[^}\n]*\}|\$<[^>\n]*>|@[A-Za-z_]\w*@'
      scope: variable.parameter.cmake

  bracket-comment:
    - meta_scope: comment.block.cmake
    - match: '\]=*\]'
      scope: punctuation.definition.comment.end.cmake
      pop: true

  bracket-arg:
    - meta_scope: string.quoted.other.cmake
    - match: '\]=*\]'
      scope: punctuation.definition.string.end.cmake
      pop: true

  dq:
    - meta_scope: string.quoted.double.cmake
    - match: '"'
      scope: punctuation.definition.string.end.cmake
      pop: true
    - match: '\\.'
      scope: constant.character.escape.cmake
    - include: vars
