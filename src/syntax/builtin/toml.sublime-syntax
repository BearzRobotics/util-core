%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: TOML
scope: source.toml
file_extensions: [toml, Cargo.lock, Pipfile, poetry.lock]
contexts:
  main:
    - include: comments
    - match: '^\s*(\[\[)'
      captures:
        1: punctuation.definition.table.array.begin.toml
      push: array-table
    - match: '^\s*(\[)'
      captures:
        1: punctuation.definition.table.begin.toml
      push: table
    - match: '(?=[A-Za-z0-9_"''-])'
      push: key-line
    - match: '='
      scope: keyword.operator.assignment.toml
      push: value-line

  comments:
    - match: '#.*$'
      scope: comment.line.number-sign.toml

  table:
    - meta_scope: meta.table.toml
    - match: '\]'
      scope: punctuation.definition.table.end.toml
      pop: true
    - include: key-parts

  array-table:
    - meta_scope: meta.table.array.toml
    - match: '\]\]'
      scope: punctuation.definition.table.array.end.toml
      pop: true
    - include: key-parts

  key-parts:
    - match: '"(?:[^"\\]|\\.)*"'
      scope: string.quoted.double.toml entity.name.section.toml
    - match: "'[^']*'"
      scope: string.quoted.single.toml entity.name.section.toml
    - match: '[A-Za-z0-9_-]+'
      scope: entity.name.section.toml
    - match: '\.'
      scope: punctuation.separator.key-value.toml
    - include: comments

  key-line:
    - match: '"(?:[^"\\]|\\.)*"'
      scope: string.quoted.double.toml entity.name.tag.toml
    - match: "'[^']*'"
      scope: string.quoted.single.toml entity.name.tag.toml
    - match: '[A-Za-z0-9_-]+'
      scope: entity.name.tag.toml
    - match: '\.'
      scope: punctuation.separator.key-value.toml
    - match: '='
      scope: keyword.operator.assignment.toml
      set: value-line
    - match: '$'
      pop: true
    - match: '(?=\S)'
      pop: true

  value-line:
    - match: '(?=\s*(?:#|$))'
      pop: true
    - include: value

  value:
    - include: comments
    - match: '"""'
      scope: punctuation.definition.string.begin.toml
      push: ml-basic
    - match: "'''"
      scope: punctuation.definition.string.begin.toml
      push: ml-literal
    - match: '"'
      scope: punctuation.definition.string.begin.toml
      push: basic-string
    - match: "'"
      scope: punctuation.definition.string.begin.toml
      push: literal-string
    - match: '\b(?:true|false)\b'
      scope: constant.language.boolean.toml
    - match: '[0-9]{4}-[0-9]{2}-[0-9]{2}(?:[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?(?:[Zz]|[-+][0-9]{2}:[0-9]{2})?)?'
      scope: constant.other.datetime.toml
    - match: '[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?'
      scope: constant.other.time.toml
    - match: '[-+]?(?:inf|nan)\b'
      scope: constant.numeric.float.toml
    - match: '0x[0-9A-Fa-f_]+'
      scope: constant.numeric.integer.hexadecimal.toml
    - match: '0o[0-7_]+'
      scope: constant.numeric.integer.octal.toml
    - match: '0b[01_]+'
      scope: constant.numeric.integer.binary.toml
    - match: '[-+]?[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][-+]?[0-9_]+)?|[eE][-+]?[0-9_]+)'
      scope: constant.numeric.float.toml
    - match: '[-+]?[0-9][0-9_]*'
      scope: constant.numeric.integer.decimal.toml
    - match: '\['
      scope: punctuation.definition.array.begin.toml
      push: array
    - match: '\{'
      scope: punctuation.definition.inline-table.begin.toml
      push: inline-table
    - match: ','
      scope: punctuation.separator.sequence.toml

  array:
    - meta_scope: meta.array.toml
    - match: '\]'
      scope: punctuation.definition.array.end.toml
      pop: true
    - include: value

  inline-table:
    - meta_scope: meta.inline-table.toml
    - match: '\}'
      scope: punctuation.definition.inline-table.end.toml
      pop: true
    - match: '(?=[A-Za-z0-9_.\-]+\s*=|"[^"]*"\s*=|''[^'']*''\s*=)'
      push: key-inline
    - include: value

  key-inline:
    - match: '"(?:[^"\\]|\\.)*"'
      scope: string.quoted.double.toml entity.name.tag.toml
    - match: "'[^']*'"
      scope: string.quoted.single.toml entity.name.tag.toml
    - match: '[A-Za-z0-9_-]+'
      scope: entity.name.tag.toml
    - match: '\.'
      scope: punctuation.separator.key-value.toml
    - match: '='
      scope: keyword.operator.assignment.toml
      pop: true
    - match: '(?=\S)'
      pop: true

  escapes:
    - match: '\\(?:[btnfr"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
      scope: constant.character.escape.toml
    - match: '\\.'
      scope: invalid.illegal.unrecognized-escape.toml

  basic-string:
    - meta_scope: string.quoted.double.toml
    - match: '"'
      scope: punctuation.definition.string.end.toml
      pop: true
    - include: escapes
    - match: '$'
      pop: true

  literal-string:
    - meta_scope: string.quoted.single.toml
    - match: "'"
      scope: punctuation.definition.string.end.toml
      pop: true
    - match: '$'
      pop: true

  ml-basic:
    - meta_scope: string.quoted.double.block.toml
    - match: '"""(?!")'
      scope: punctuation.definition.string.end.toml
      pop: true
    - include: escapes

  ml-literal:
    - meta_scope: string.quoted.single.block.toml
    - match: "'''(?!')"
      scope: punctuation.definition.string.end.toml
      pop: true
