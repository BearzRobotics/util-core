%YAML 1.2
---
# Original grammar written for util-core (GPL-2.0-or-later).
name: JavaScript
scope: source.js
file_extensions:
  - js
  - mjs
  - cjs
  - jsx
  - es6
first_line_match: '^#!.*\bnode\b|^#!/usr/bin/env\s+(?:node|nodejs|deno|bun)\b|-\*-\s*(?:js|javascript)\s*-\*-'

variables:
  ident: '[A-Za-z_$][A-Za-z0-9_$]*'

contexts:
  main:
    - match: '^#!.*$'
      scope: comment.line.shebang.js
    - include: code

  code:
    - include: comments
    - include: strings
    - include: regex
    - include: jsx
    - include: numbers
    - include: decorators
    - include: keywords
    - include: builtins
    - include: functions
    - include: operators
    - match: '\{'
      push: braces

  braces:
    - match: '\}'
      pop: true
    - include: code

  comments:
    - match: '/\*\*(?!/)'
      scope: punctuation.definition.comment.begin.js
      push: doc-block-comment
    - match: '/\*'
      scope: punctuation.definition.comment.begin.js
      push: block-comment
    - match: '//.*$'
      scope: comment.line.double-slash.js
    - match: '<!--.*$'
      scope: comment.line.html.js

  block-comment:
    - meta_scope: comment.block.js
    - match: '\*/'
      scope: punctuation.definition.comment.end.js
      pop: true

  doc-block-comment:
    - meta_scope: comment.block.documentation.js
    - match: '\*/'
      scope: punctuation.definition.comment.end.js
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.js
      push: dq-string
    - match: '\x27'
      scope: punctuation.definition.string.begin.js
      push: sq-string
    - match: '`'
      scope: string.template.js punctuation.definition.string.begin.js
      push: template

  dq-string:
    - meta_scope: string.quoted.double.js
    - match: '"'
      scope: punctuation.definition.string.end.js
      pop: true
    - include: string-escapes
    - match: '\n'
      pop: true

  sq-string:
    - meta_scope: string.quoted.single.js
    - match: '\x27'
      scope: punctuation.definition.string.end.js
      pop: true
    - include: string-escapes
    - match: '\n'
      pop: true

  string-escapes:
    - match: '\\(?:x\h{2}|u\h{4}|u\{\h+\}|[0-7]{1,3}|.)'
      scope: constant.character.escape.js
    - match: '\\\n'
      scope: constant.character.escape.js

  template:
    - match: '`'
      scope: string.template.js punctuation.definition.string.end.js
      pop: true
    - match: '\\(?:x\h{2}|u\h{4}|u\{\h+\}|[0-7]{1,3}|.)|\\\n'
      scope: string.template.js constant.character.escape.js
    - match: '\$\{'
      scope: punctuation.section.interpolation.begin.js
      push: template-interp
    - match: '[^`\\$]+|\$'
      scope: string.template.js

  template-interp:
    - match: '\}'
      scope: punctuation.section.interpolation.end.js
      pop: true
    - include: code

  regex:
    - match: '^(\s*)(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        2: punctuation.definition.string.begin.js
      push: regex-body
    - match: '([=(,:;!&|?\[+\-*%<>~^]+)(\s*)(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        1: keyword.operator.js
        3: punctuation.definition.string.begin.js
      push: regex-body
    - match: '\b(return|typeof|case|in|of|delete|void|throw|yield|await|else|do)(\s+|\s*(?=/))(/)(?![/*])(?=(?:[^/\\\[\n]|\\.|\[(?:[^\]\\\n]|\\.)*\])+/)'
      captures:
        1: keyword.control.js
        3: punctuation.definition.string.begin.js
      push: regex-body

  regex-body:
    - meta_scope: string.regexp.js
    - match: '(/)([dgimsuvy]*)'
      captures:
        1: punctuation.definition.string.end.js
        2: keyword.other.js
      pop: true
    - match: '\\.'
      scope: constant.character.escape.js
    - match: '\[(?:[^\]\\\n]|\\.)*\]'
      scope: constant.other.character-class.set.js
    - match: '[()|*+?]|\{\d+(?:,\d*)?\}'
      scope: keyword.operator.regexp.js
    - match: '\n'
      pop: true

  jsx:
    - match: '^(\s*)(<)(/?)([A-Za-z][\w.:-]*)(?=[\s/>])'
      captures:
        2: punctuation.definition.tag.begin.js
        3: punctuation.definition.tag.begin.js
        4: entity.name.tag.js
      push: jsx-tag
    - match: '(?:[=(,:?&|\[]|=>|\breturn)(\s*)(<)(/?)([A-Za-z][\w.:-]*)(?=[\s/>])'
      captures:
        2: punctuation.definition.tag.begin.js
        3: punctuation.definition.tag.begin.js
        4: entity.name.tag.js
      push: jsx-tag
    - match: '(</)([A-Za-z][\w.:-]*)(>)'
      captures:
        1: punctuation.definition.tag.begin.js
        2: entity.name.tag.js
        3: punctuation.definition.tag.end.js

  jsx-tag:
    - match: '/?>'
      scope: punctuation.definition.tag.end.js
      pop: true
    - match: '[A-Za-z_][\w:.-]*'
      scope: entity.other.attribute-name.js
    - match: '"[^"]*"'
      scope: string.quoted.double.js
    - match: '\x27[^\x27]*\x27'
      scope: string.quoted.single.js
    - match: '\{'
      push: braces
    - include: comments
    - match: '='
      scope: keyword.operator.assignment.js

  numbers:
    - match: '(?<![\w$.])0[xX][\h_]+n?(?![\w$])'
      scope: constant.numeric.hex.js
    - match: '(?<![\w$.])0[oO][0-7_]+n?(?![\w$])'
      scope: constant.numeric.octal.js
    - match: '(?<![\w$.])0[bB][01_]+n?(?![\w$])'
      scope: constant.numeric.binary.js
    - match: '(?<![\w$.])(?:\d[\d_]*\.[\d_]*|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?![\w$])'
      scope: constant.numeric.float.js
    - match: '(?<![\w$.])\d[\d_]*[eE][+-]?\d[\d_]*(?![\w$])'
      scope: constant.numeric.float.js
    - match: '(?<![\w$.])\d[\d_]*n?(?![\w$])'
      scope: constant.numeric.integer.js

  decorators:
    - match: '@{{ident}}(?:\.{{ident}})*'
      scope: meta.annotation.js

  keywords:
    - match: '\b(?:if|else|for|while|do|switch|case|default|break|continue|return|throw|try|catch|finally|yield|await|with|debugger)\b'
      scope: keyword.control.js
    - match: '\b(?:import|export|from)\b(?=\s*(?:[{*"\x27]|$|\w))'
      scope: keyword.control.import.js
    - match: '\b(?:import|export)\b'
      scope: keyword.control.import.js
    - match: '\b(function)\b(?:(\s*\*?\s*)({{ident}}))?'
      captures:
        1: storage.type.function.js
        3: entity.name.function.js
    - match: '\b(class)\b(?:\s+({{ident}}))?(?:\s+(extends)\s+({{ident}}(?:\.{{ident}})*))?'
      captures:
        1: storage.type.class.js
        2: entity.name.class.js
        3: storage.modifier.extends.js
        4: entity.other.inherited-class.js
    - match: '\bextends\b'
      scope: storage.modifier.extends.js
    - match: '\b(var|let|const)\b(?:\s+({{ident}})(?=\s*=\s*(?:async\s+)?(?:function\b|\([^()]*\)\s*=>|{{ident}}\s*=>)))?'
      captures:
        1: storage.type.js
        2: entity.name.function.js
    - match: '\b(?:var|let|const)\b'
      scope: storage.type.js
    - match: '\b(?:static|async)\b(?=\s+(?:function\b|{{ident}}|\*|\[|\())'
      scope: storage.modifier.js
    - match: '\b(?:get|set)\b(?=\s+{{ident}}\s*\()'
      scope: storage.modifier.js
    - match: '\b(new)\b(?:\s+({{ident}}))?'
      captures:
        1: keyword.operator.new.js
        2: entity.name.class.js
    - match: '\b(?:delete|typeof|instanceof|in|of|void)\b'
      scope: keyword.operator.word.js
    - match: '\b(?:this|super|arguments)\b'
      scope: variable.language.js
    - match: '\b(?:true|false|null|undefined|NaN|Infinity)\b'
      scope: constant.language.js

  builtins:
    - match: '\b(?:Array|Object|String|Number|Boolean|Symbol|BigInt|Function|Map|Set|WeakMap|WeakSet|WeakRef|Promise|Date|RegExp|Error|EvalError|RangeError|ReferenceError|SyntaxError|TypeError|URIError|AggregateError|Math|JSON|Reflect|Proxy|Intl|ArrayBuffer|SharedArrayBuffer|DataView|Atomics|Int8Array|Uint8Array|Uint8ClampedArray|Int16Array|Uint16Array|Int32Array|Uint32Array|Float32Array|Float64Array|BigInt64Array|BigUint64Array|Buffer|URL|URLSearchParams|TextEncoder|TextDecoder)\b'
      scope: support.class.builtin.js
    - match: '\b(?:console|window|document|process|module|exports|globalThis|global|navigator|localStorage|sessionStorage|__dirname|__filename)\b'
      scope: support.type.object.js
    - match: '\b(?:require|parseInt|parseFloat|isNaN|isFinite|setTimeout|setInterval|clearTimeout|clearInterval|setImmediate|queueMicrotask|fetch|alert|encodeURIComponent|decodeURIComponent|encodeURI|decodeURI|structuredClone)(?=\s*\()'
      scope: support.function.js

  functions:
    - match: '{{ident}}(?=\s*\()'
      scope: entity.name.function.js

  operators:
    - match: '=>'
      scope: storage.type.function.arrow.js
    - match: '\.\.\.|\?\?=?|\?\.(?!\d)|\*\*=?|&&=?|\|\|=?|>>>=?|>>=?|<<=?|[-+*/%&|^!<>=]=?=?|~|\?|:'
      scope: keyword.operator.js
